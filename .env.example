# Example environment variables for development — safe to commit
# Copy this to `.env` and fill in secrets for local development.

# Database configuration
DB_HOST=db
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=example
DB_NAME=deckmaster

# Application
PORT=8080

# Goose
export GOOSE_DRIVER=postgres
export GOOSE_DBSTRING=postgres://postgres:example@db:5432/deckmaster?sslmode=disable
export GOOSE_MIGRATION_DIR=./migrations
