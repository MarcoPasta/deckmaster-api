# Example environment variables for development — safe to commit
# Copy this to `.env` and fill in secrets for local development.

# Database configuration
DB_HOST=db
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=example
DB_NAME=deckmaster

# Test database configuration
TEST_DB_HOST=test-db
TEST_DB_PORT=15432
TEST_DB_USER=postgres
TEST_DB_PASSWORD=example
TEST_DB_NAME=deckmaster-test

# Application
PORT=8080

# file paths
POKEMON_SCRAPER_DIR=../files/pokemon/json/
POKEMON_SEEDER_DIR=../../../files/pokemon/json/ # used for seeding & testing
DIGIMON_SCRAPER_DIR=../files/digimon/json/
DIGIMON_SEEDER_DIR=../../../files/digimon/json/ # used for seeding & testing
NARUTO_SCRAPER_DIR=../files/naruto/json/
NARUTO_SEEDER_DIR=../../../files/naruto/json/ # used for seeding

# Goose
GOOSE_DRIVER=postgres
GOOSE_MIGRATION_DIR=./migrations

# Clerk
CLERK_BACKEND_API=https://api.clerk.com/v1
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=hidden
CLERK_SECRET_KEY=secret
