{
  "name": "deckmaster-dev",
  "dockerComposeFile": ["../docker-compose.yml", "../docker-compose.dev.yml"],
  "service": "dev",
  "workspaceFolder": "/workspace",
  "remoteUser": "dev",
  "runServices": ["db"],
  "shutdownAction": "stopCompose",
  "forwardPorts": [8080, 8000, 5432],
  "postCreateCommand": "cp .env || true",
  "postStartCommand": "chmod +x ./install_dev_deps.sh",
  "postAttachCommand": "./install_dev_deps.sh && export PATH=\"$HOME/.local/bin:$PATH\"",
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash",
        "terminal.integrated.profiles.linux": {
          "bash": {
            "path": "/bin/bash"
          }
        }
      },
      "extensions": [
        "golang.go"
      ]
    }
  }
}
